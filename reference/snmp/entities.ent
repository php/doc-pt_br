<!--
    See `manual.xml` for XML namespaces defaults.
    Keep the lines under 79 columns, to make the process of manual
    translation easier, and to avoid wrap-around in some other contexts.
-->
<entities xmlns       = "http://docbook.org/ns/docbook"
          xmlns:xlink = "http://www.w3.org/1999/xlink"
          translate   = "yes">

<entity name="ext.snmp.changelog.object-id-valueerror">
 <row>
  <entry>8.0.0</entry>
  <entry>
   Agora lança uma <exceptionname>ValueError</exceptionname> se
   <parameter>object_id</parameter> for um <type>array</type> vazio.
   Anteriormente, um <constant>E_WARNING</constant> era gerado e &false;
   era retornado.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.security-valueerror">
 <row>
  <entry>8.0.0</entry>
  <entry>
   Agora lança uma <exceptionname>ValueError</exceptionname> se
   <parameter>security_level</parameter> não for um nível de segurança válido, ou
   se <parameter>auth_protocol</parameter> ou
   <parameter>privacy_protocol</parameter> não for um protocolo suportado e
   <parameter>security_level</parameter> o utilizar.
   Anteriormente, um <constant>E_WARNING</constant> era gerado e &false;
   era retornado.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.session-valueerror">
 <row>
  <entry>8.5.0</entry>
  <entry>
   Agora lança uma <exceptionname>ValueError</exceptionname> quando
   <parameter>hostname</parameter> ou <parameter>community</parameter>
   contiver bytes nulos, quando o comprimento do hostname for igual ou maior
   que 128 bytes, quando <parameter>community</parameter> estiver vazio, quando
   a porta for negativa ou maior que 65535, ou quando os valores de timeout ou
   retries forem menores que -1 ou muito grandes.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.session-valueerror.v3">
 <row>
  <entry>8.5.0</entry>
  <entry>
   Agora lança uma <exceptionname>ValueError</exceptionname> quando
   <parameter>hostname</parameter> ou <parameter>security_name</parameter>
   contiver bytes nulos, quando o comprimento do hostname for igual ou maior
   que 128 bytes, quando <parameter>security_name</parameter> estiver vazio, quando
   a porta for negativa ou maior que 65535, ou quando os valores de timeout ou
   retries forem menores que -1 ou muito grandes.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.set-type-errors">
 <row>
  <entry>8.0.0</entry>
  <entry>
   Agora lança uma <exceptionname>TypeError</exceptionname> se
   <parameter>object_id</parameter> for uma <type>string</type> e
   <parameter>type</parameter> ou <parameter>value</parameter> for um
   <type>array</type>, e uma <exceptionname>ValueError</exceptionname> se um
   tipo não for um único caractere.
   Anteriormente, um <constant>E_WARNING</constant> era gerado e &false;
   era retornado.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.object-id-valueerror">
 <simpara>
  Lança uma <exceptionname>ValueError</exceptionname> se
  <parameter>object_id</parameter> for um <type>array</type> vazio.
 </simpara>
</entity>

<entity name="ext.snmp.security-valueerror">
 <simpara>
  Lança uma <exceptionname>ValueError</exceptionname> se
  <parameter>security_level</parameter> não for um nível de segurança válido, ou
  se <parameter>auth_protocol</parameter> ou
  <parameter>privacy_protocol</parameter> não for um protocolo suportado e
  <parameter>security_level</parameter> o utilizar.
 </simpara>
</entity>

<entity name="ext.snmp.session-valueerror">
 <simpara>
  A partir do PHP 8.5.0, lança uma <exceptionname>ValueError</exceptionname> se
  <parameter>hostname</parameter> ou <parameter>community</parameter>
  contiver bytes nulos, se o comprimento do <parameter>hostname</parameter> for igual ou maior
  que 128 bytes ou contiver uma porta que não esteja entre 0 e 65535, se
  <parameter>community</parameter> estiver vazio, ou se
  <parameter>timeout</parameter> ou <parameter>retries</parameter> forem menores
  que <literal>-1</literal> ou muito grandes.
 </simpara>
</entity>

<entity name="ext.snmp.session-valueerror.v3">
 <simpara>
  A partir do PHP 8.5.0, lança uma <exceptionname>ValueError</exceptionname> se
  <parameter>hostname</parameter> ou <parameter>security_name</parameter>
  contiver bytes nulos, quando o comprimento do <parameter>hostname</parameter> for igual ou maior
  que 128 bytes ou contiver uma porta que não esteja entre 0 e 65535, se
  <parameter>security_name</parameter> estiver vazio, ou se
  <parameter>timeout</parameter> ou <parameter>retries</parameter> forem menores
  que <literal>-1</literal> ou muito grandes.
 </simpara>
</entity>

<entity name="ext.snmp.set-type-errors">
 <simpara>
  Lança uma <exceptionname>TypeError</exceptionname> se
  <parameter>object_id</parameter> for uma <type>string</type> e
  <parameter>type</parameter> ou <parameter>value</parameter> for um
  <type>array</type>.
  Lança uma <exceptionname>ValueError</exceptionname> se
  <parameter>object_id</parameter> for uma <type>string</type> e
  <parameter>type</parameter> não for um único caractere, ou se
  <parameter>type</parameter> for um <type>array</type> e o tipo de um
  ID de objeto não for um único caractere.
 </simpara>
</entity>

</entities>
