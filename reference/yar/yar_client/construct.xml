<refentry xml:id="yar-client.construct" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Yar_Client::__construct</refname>
  <refpurpose>Cria um cliente</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <constructorsynopsis role="Yar_Client">
   <modifier>final</modifier> <modifier>public</modifier> <methodname>Yar_Client::__construct</methodname>
   <methodparam><type>string</type><parameter>uri</parameter></methodparam>
   <methodparam choice="opt"><type class="union"><type>array</type><type>null</type></type><parameter>options</parameter><initializer>null</initializer></methodparam>
  </constructorsynopsis>
  <simpara>
   Cria um <classname>Yar_Client</classname> para o serviço RPC localizado em
   <literal>uri</literal>.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>uri</parameter></term>
    <listitem>
     <simpara>
      Endereço do serviço RPC. O protocolo é derivado do esquema:
      <literal>http://</literal> e <literal>https://</literal> selecionam o transporte HTTP, <literal>tcp://</literal>
      seleciona o transporte TCP e <literal>unix://</literal> seleciona o transporte de
      socket Unix.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>options</parameter></term>
    <listitem>
     <simpara>
      Um &array; de opções do cliente, indexado pelas
      constantes <literal>YAR_OPT_*</literal>, equivalente a chamar
      <methodname>Yar_Client::setOpt</methodname> para cada entrada. Opções inválidas são
      ignoradas silenciosamente.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Uma nova instância de <classname>Yar_Client</classname>.
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Se o URI não começar com um esquema suportado, uma <exceptionname>Yar_Client_Protocol_Exception</exceptionname> será
   lançada.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>Exemplo de <methodname>Yar_Client::__construct</methodname></title>
   <programlisting role="php">
<![CDATA[
<?php
$client = new Yar_Client("http://api.example.com/operator.php");

/* com opções */
$client = new Yar_Client("http://api.example.com/operator.php", [
    YAR_OPT_TIMEOUT => 1000,
    YAR_OPT_PACKAGER => "json",
]);
?>
]]>
   </programlisting>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Yar_Client::call</methodname></member>
   <member><methodname>Yar_Client::setOpt</methodname></member>
  </simplelist>
 </refsect1>

</refentry>

