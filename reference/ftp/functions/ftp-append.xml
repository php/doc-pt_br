<refentry xml:id="function.ftp-append" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>ftp_append</refname>
  <refpurpose>Acrescenta o conteúdo de um arquivo a outro arquivo no servidor FTP</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>bool</type><methodname>ftp_append</methodname>
   <methodparam><type>FTP\Connection</type><parameter>ftp</parameter></methodparam>
   <methodparam><type>string</type><parameter>remote_filename</parameter></methodparam>
   <methodparam><type>string</type><parameter>local_filename</parameter></methodparam>
   <methodparam choice="opt"><type>int</type><parameter>mode</parameter><initializer><constant>FTP_BINARY</constant></initializer></methodparam>
  </methodsynopsis>
  <simpara>
   <function>ftp_append</function> envia o conteúdo de
   <parameter>local_filename</parameter> ao servidor FTP, acrescentando-o a
   <parameter>remote_filename</parameter> em vez de sobrescrevê-lo.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>ftp</parameter></term>
    <listitem>
      &ftp.parameter.ftp;
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>remote_filename</parameter></term>
    <listitem>
     <simpara>
      O caminho do arquivo remoto ao qual acrescentar o conteúdo.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>local_filename</parameter></term>
    <listitem>
     <simpara>
      O caminho do arquivo local cujo conteúdo será enviado.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>mode</parameter></term>
    <listitem>
     <simpara>
      O modo de transferência. Deve ser <constant>FTP_ASCII</constant> ou
      <constant>FTP_BINARY</constant>.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.success;
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  &ext.ftp.mode-valueerror;
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     &ftp.changelog.ftp-param;
     &ext.ftp.changelog.mode-valueerror;
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

</refentry>
