<chapter xml:id="taint.setup" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 &reftitle.setup;

 <section xml:id="taint.requirements">
  &reftitle.required;
  <simpara>
   Taint 3.x requer PHP 8.0 ou mais recente. Para PHP 7.x, use as versões
   taint 2.1.x; para PHP 5.x, use as versões taint 1.x.
  </simpara>
 </section>

 <!-- {{{ Installation -->
 &reference.taint.configure;
 <!-- }}} -->

 <!-- {{{ Configuration -->
 &reference.taint.ini;
 <!-- }}} -->

 <section xml:id="taint.resources">
  &reftitle.resources;
  <simpara>
   Taint não define tipos de recursos. A própria marca de contaminação é
   armazenada na estrutura interna <literal>zend_string</literal>, não em um
   recurso visível ao usuário.
  </simpara>
 </section>

</chapter>

