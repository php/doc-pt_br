<refentry xml:id="function.is-tainted" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>is_tainted</refname>
  <refpurpose>Verifica se uma string está contaminada</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>bool</type><methodname>is_tainted</methodname>
   <methodparam><type>string</type><parameter>string</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Verifica se o valor fornecido tem a marca de contaminação. Somente strings
   podem ser contaminadas; qualquer outro tipo retorna &false;.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>string</parameter></term>
    <listitem>
     <simpara>
      O valor a verificar.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Retorna &true; se o valor for uma string contaminada e &false; caso
   contrário. Sempre retorna &false; quando
   <link linkend="ini.taint.enable">taint.enable</link> está desativado.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>Exemplo de <function>is_tainted</function></title>
   <programlisting role="php">
<![CDATA[
<?php
$name = $_GET['name'] ?? 'world';
var_dump(is_tainted($name));
?>
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
bool(true)
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>taint</function></member>
    <member><function>untaint</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>

