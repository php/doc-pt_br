<refentry xml:id="time-duration.frommilliseconds" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Time\Duration::fromMilliseconds</refname>
  <refpurpose>Cria uma duração a partir de uma quantidade de milissegundos</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="Time\\Duration">
   <modifier>public</modifier> <modifier>static</modifier> <type>Time\Duration</type><methodname>Time\Duration::fromMilliseconds</methodname>
   <methodparam><type>int</type><parameter>milliseconds</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Cria uma duração não negativa de <parameter>milliseconds</parameter> milissegundos.
   O valor é normalizado em segundos inteiros e nanossegundos; consulte as propriedades
   <property>Time\Duration::$seconds</property> and
   <property>Time\Duration::$nanoseconds</property> properties.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>milliseconds</parameter></term>
    <listitem>
     <simpara>
      A quantidade de milissegundos.
      Deve ser maior ou igual a <literal>0</literal>.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Retorna um novo objeto <classname>Time\Duration</classname>.
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <itemizedlist>
   <listitem>
    <simpara>
     Se <parameter>milliseconds</parameter> for negativo, será lançado um
     <exceptionname>ValueError</exceptionname>.
    </simpara>
   </listitem>
  </itemizedlist>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example xml:id="time-duration.frommilliseconds.example.basic">
   <title>Exemplo de <methodname>Time\Duration::fromMilliseconds</methodname></title>
   <programlisting role="php">
<![CDATA[
<?php
var_dump(\Time\Duration::fromMilliseconds(2500));
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
object(Time\Duration)#1 (3) {
  ["seconds"]=>
  int(2)
  ["nanoseconds"]=>
  int(500000000)
  ["negative"]=>
  bool(false)
}
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Time\Duration::fromSeconds</methodname></member>
   <member><methodname>Time\Duration::fromMicroseconds</methodname></member>
   <member><methodname>Time\Duration::fromMinutes</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
