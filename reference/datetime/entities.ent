<entities xmlns       = "http://docbook.org/ns/docbook"
          xmlns:xlink = "http://www.w3.org/1999/xlink"
          translate   = "yes">

<entity name="ext.datetime.duration-too-long">
 <listitem>
  <simpara>
   Se a duração resultante exceder o
   <link linkend="time-duration.intro">comprimento máximo de uma duração</link>,
   será lançada uma <exceptionname>Time\TimeException</exceptionname>.
  </simpara>
 </listitem>
</entity>

</entities>
