<refentry xml:id="function.dcgettext" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>dcgettext</refname>
  <refpurpose>Substitui o domínio padrão para uma procura única</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>dcgettext</methodname>
   <methodparam><type>string</type><parameter>domain</parameter></methodparam>
   <methodparam><type>string</type><parameter>message</parameter></methodparam>
   <methodparam><type>int</type><parameter>category</parameter></methodparam>
  </methodsynopsis>
  <para>
   Esta função substituir o domínio padrão para uma
   busca única de mensagem.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>domain</parameter></term>
     <listitem>
      <para>
       O domínio.
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>message</parameter></term>
     <listitem>
      <para>
       A mensagem.
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>category</parameter></term>
     <listitem>
      <para>
       A categoria.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Uma <type>string</type> em caso de sucesso.
  </para>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Lança uma exceção <exceptionname>ValueError</exceptionname> se <parameter>domain</parameter>
   for uma <type>string</type> vazia ou tiver mais de 1024 bytes.
  </simpara>
  <simpara>
   Lança uma exceção <exceptionname>ValueError</exceptionname> se <parameter>message</parameter>
   tiver mais de 4096 bytes.
  </simpara>
  <simpara>
   Lança uma exceção <exceptionname>ValueError</exceptionname> se <parameter>category</parameter>
   for <constant>LC_ALL</constant>.
  </simpara>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.4.0</entry>
      <entry>
       Agora lança uma exceção <exceptionname>ValueError</exceptionname> se <parameter>domain</parameter>
       for uma <type>string</type> vazia ou <parameter>category</parameter>
       for <constant>LC_ALL</constant>.
      </entry>
     </row>
     <row>
      <entry>8.0.0</entry>
      <entry>
       Agora lança uma exceção <exceptionname>ValueError</exceptionname> se um argumento
       for longo demais. Anteriormente, um <constant>E_WARNING</constant> era emitido
       e &false; era retornado.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>gettext</function></member>
   </simplelist>
  </para>
 </refsect1>
</refentry>

