<refentry xml:id="mysqli.stmt-init" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>mysqli::stmt_init</refname>
  <refname>mysqli_stmt_init</refname>
  <refpurpose>Inicializa uma instrução e retorna um objeto para uso com mysqli_stmt_prepare</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <para>&style.oop;</para>
  <methodsynopsis role="mysqli">
   <modifier>public</modifier> <type class="union"><type>mysqli_stmt</type><type>false</type></type><methodname>mysqli::stmt_init</methodname>
   <void/>
  </methodsynopsis>
  <para>&style.procedural;</para>
  <methodsynopsis>
   <type class="union"><type>mysqli_stmt</type><type>false</type></type><methodname>mysqli_stmt_init</methodname>
   <methodparam><type>mysqli</type><parameter>mysql</parameter></methodparam>
  </methodsynopsis>
  <para>
   Aloca e inicializa um objeto de instrução adequado para
   <function>mysqli_stmt_prepare</function>.
  </para>
  <note>
   <simpara>
    Qualquer chamada subseqüente para qualquer método <classname>mysqli_stmt</classname>
    falhará até que <function>mysqli_stmt_prepare</function> seja chamado.
   </simpara>
  </note>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    &mysqli.link.description;
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Retorna um objeto <classname>mysqli_stmt</classname>.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>mysqli_stmt_prepare</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
