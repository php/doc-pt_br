<refentry xml:id="swoole-timer.set" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Swoole\Timer::set</refname>
  <refpurpose>Define parâmetros relacionados aos temporizadores</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <modifier>static</modifier> <type>void</type><methodname>Swoole\Timer::set</methodname>
   <methodparam><type>array</type><parameter>settings</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Define as opções usadas pelos temporizadores do processo atual.
  </simpara>

  <warning>
   <simpara>
    Este método foi descontinuado no Swoole 4.6.0 e removido no Swoole 6.0.0.
    Use <function>swoole_async_set</function> em seu lugar.
   </simpara>
  </warning>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>settings</parameter></term>
    <listitem>
     <simpara>
      Um array associativo de opções. Apenas <literal>enable_coroutine</literal>
      é reconhecida: quando definida como &false;, as funções de retorno de chamada dos
      temporizadores são executadas diretamente, em vez de dentro de uma corrotina recém-criada.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>
</refentry>

