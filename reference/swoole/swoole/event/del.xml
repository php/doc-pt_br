<refentry xml:id="swoole-event.del" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Swoole\Event::del</refname>
  <refpurpose>Remove um socket do monitor de eventos</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <modifier>static</modifier> <type>bool</type><methodname>Swoole\Event::del</methodname>
   <methodparam><type>mixed</type><parameter>sock</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Remove um socket do monitor de eventos.
  </simpara>
  <warning>
   <simpara>
    Sempre chame Event::del para cancelar o registro do monitoramento de eventos antes de fechar o socket.
    A falha em fazê-lo pode resultar em vazamentos de memória.
   </simpara>
  </warning>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>sock</parameter></term>
    <listitem>
     <simpara>
      Descritor de arquivo do socket a ser removido.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.success;
  </simpara>
 </refsect1>
</refentry>

