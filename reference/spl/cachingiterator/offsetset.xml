<refentry xml:id="cachingiterator.offsetset" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>CachingIterator::offsetSet</refname>
  <refpurpose>Define um elemento no cache</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="CachingIterator">
   <modifier>public</modifier> <type>void</type><methodname>CachingIterator::offsetSet</methodname>
   <methodparam><type>string</type><parameter>key</parameter></methodparam>
   <methodparam><type>mixed</type><parameter>value</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Armazena <parameter>value</parameter> sob a chave <parameter>key</parameter> no
   cache.
   Este método é chamado quando um valor é atribuído ao
   <classname>CachingIterator</classname> usando a sintaxe de array, como
   <code>$iterator['key'] = $value</code>.
   O iterador interno não é modificado.
  </simpara>
  <simpara>
   A opção <constant>CachingIterator::FULL_CACHE</constant> deve estar definida.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>key</parameter></term>
    <listitem>
     <simpara>
      A chave do elemento a ser definido.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>value</parameter></term>
    <listitem>
     <simpara>
      O novo valor para a chave <parameter>key</parameter>.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>

 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Lança uma <exceptionname>BadMethodCallException</exceptionname> se a
   opção <constant>CachingIterator::FULL_CACHE</constant> não estiver definida.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>CachingIterator::offsetGet</methodname></member>
   <member><methodname>CachingIterator::offsetUnset</methodname></member>
   <member><methodname>CachingIterator::getCache</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
