<refentry xml:id="cachingiterator.next" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>CachingIterator::next</refname>
  <refpurpose>Move o iterador para frente</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="CachingIterator">
   <modifier>public</modifier> <type>void</type><methodname>CachingIterator::next</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Move o iterador para frente.
  </simpara>
  <simpara>
   Se o iterador interno for válido, sua chave e elemento atuais se tornam a
   chave e elemento atuais do <classname>CachingIterator</classname>,
   e são adicionados ao cache se
   <constant>CachingIterator::FULL_CACHE</constant> estiver definido.
   O iterador interno é então movido para frente.
   Caso contrário, o <classname>CachingIterator</classname> não é mais válido.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>CachingIterator::rewind</methodname></member>
   <member><methodname>CachingIterator::hasNext</methodname></member>
   <member><methodname>CachingIterator::valid</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
