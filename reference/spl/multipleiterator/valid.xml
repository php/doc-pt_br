<refentry xml:id="multipleiterator.valid" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>MultipleIterator::valid</refname>
  <refpurpose>Verifica a validade dos subiteradores</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="MultipleIterator">
   <modifier>public</modifier> <type>bool</type><methodname>MultipleIterator::valid</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Verifica a validade dos iteradores anexados. Com
   <constant>MultipleIterator::MIT_NEED_ALL</constant>, todos eles devem ser
   válidos; com <constant>MultipleIterator::MIT_NEED_ANY</constant>, pelo menos
   um deles deve ser válido.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Retorna &true; se todos os iteradores anexados forem válidos
   (<constant>MultipleIterator::MIT_NEED_ALL</constant>) ou se pelo menos um for
   válido (<constant>MultipleIterator::MIT_NEED_ANY</constant>), caso contrário
   retorna &false;. Se nenhum iterador estiver anexado, &false; é retornado.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>MultipleIterator::__construct</methodname></member>
   <member><methodname>MultipleIterator::setFlags</methodname></member>
   <member><methodname>MultipleIterator::current</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
