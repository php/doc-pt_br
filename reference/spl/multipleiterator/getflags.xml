<refentry xml:id="multipleiterator.getflags" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>MultipleIterator::getFlags</refname>
  <refpurpose>Obtém informações sobre as opções</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="MultipleIterator">
   <modifier>public</modifier> <type>int</type><methodname>MultipleIterator::getFlags</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Obtém as opções que controlam como os iteradores anexados são percorridos.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Retorna uma máscara de bits das
   <link linkend="multipleiterator.constants">constantes de MultipleIterator</link>.
   Como <constant>MultipleIterator::MIT_NEED_ANY</constant>
   e <constant>MultipleIterator::MIT_KEYS_NUMERIC</constant> são
   <literal>0</literal>, use o operador binário
   <link linkend="language.operators.bitwise">&amp;</link> para verificar
   <constant>MultipleIterator::MIT_NEED_ALL</constant> e
   <constant>MultipleIterator::MIT_KEYS_ASSOC</constant>.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>Verificando as opções</title>
   <programlisting role="php">
<![CDATA[
<?php
$iterator = new MultipleIterator(MultipleIterator::MIT_NEED_ANY | MultipleIterator::MIT_KEYS_ASSOC);

var_dump((bool) ($iterator->getFlags() & MultipleIterator::MIT_NEED_ALL));
var_dump((bool) ($iterator->getFlags() & MultipleIterator::MIT_KEYS_ASSOC));
?>
]]>
   </programlisting>
   &example.outputs;
   <screen>
<![CDATA[
bool(false)
bool(true)
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><link linkend="multipleiterator.constants">Constantes de Opção</link></member>
   <member><methodname>MultipleIterator::__construct</methodname></member>
   <member><methodname>MultipleIterator::setFlags</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
