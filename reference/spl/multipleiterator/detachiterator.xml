<refentry xml:id="multipleiterator.detachiterator" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>MultipleIterator::detachIterator</refname>
  <refpurpose>Desanexa um iterador</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="MultipleIterator">
   <modifier>public</modifier> <type>void</type><methodname>MultipleIterator::detachIterator</methodname>
   <methodparam><type>Iterator</type><parameter>iterator</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Desanexa um iterador, juntamente com suas informações associadas. Nada
   acontece se <parameter>iterator</parameter> não estiver anexado.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>iterator</parameter></term>
    <listitem>
     <simpara>
      O iterador a ser desanexado.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>MultipleIterator::attachIterator</methodname></member>
   <member><methodname>MultipleIterator::containsIterator</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
