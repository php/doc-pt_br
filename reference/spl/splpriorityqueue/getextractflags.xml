<refentry xml:id="splpriorityqueue.getextractflags" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>SplPriorityQueue::getExtractFlags</refname>
  <refpurpose>Obtém as opções de extração</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="SplPriorityQueue">
   <modifier>public</modifier> <type>int</type><methodname>SplPriorityQueue::getExtractFlags</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Obtém as opções que definem o que é extraído por
   <methodname>SplPriorityQueue::current</methodname>,
   <methodname>SplPriorityQueue::top</methodname> e
   <methodname>SplPriorityQueue::extract</methodname>.
  </simpara>

 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Retorna as opções de extração, que são uma das seguintes:
  </simpara>
  <itemizedlist>
   <listitem><simpara><constant>SplPriorityQueue::EXTR_DATA</constant> (0x00000001): Extrai os dados</simpara></listitem>
   <listitem><simpara><constant>SplPriorityQueue::EXTR_PRIORITY</constant> (0x00000002): Extrai a prioridade</simpara></listitem>
   <listitem><simpara><constant>SplPriorityQueue::EXTR_BOTH</constant> (0x00000003): Extrai um array contendo ambos</simpara></listitem>
  </itemizedlist>
  <simpara>
   O padrão é <constant>SplPriorityQueue::EXTR_DATA</constant>.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>SplPriorityQueue::setExtractFlags</methodname></member>
   <member><methodname>SplPriorityQueue::current</methodname></member>
   <member><methodname>SplPriorityQueue::top</methodname></member>
   <member><methodname>SplPriorityQueue::extract</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
