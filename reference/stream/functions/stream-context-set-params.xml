<refentry xml:id="function.stream-context-set-params" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>stream_context_set_params</refname>
  <refpurpose>Define parâmetros para um fluxo/empacotador/contexto</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>true</type><methodname>stream_context_set_params</methodname>
   <methodparam><type>resource</type><parameter>context</parameter></methodparam>
   <methodparam><type>array</type><parameter>params</parameter></methodparam>
  </methodsynopsis>
  <para>
   Define parâmetros para o contexto especificado.
  </para>
 </refsect1>

 <refsect1 role="parameters"><!-- {{{ -->
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>context</parameter></term>
     <listitem>
      <para>
       O fluxo ou contexto ao qual os parâmetros devem ser aplicados.
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>params</parameter></term>
     <listitem>
      <para>
       Um array associativo de parâmetros a serem definidos no seguinte formato:
       <literal>$params['nome_parametro'] = "valor_parametro";</literal>.
      </para>
      <table>
       <title>Parâmetros suportados</title>
       <tgroup cols="2">
        <thead>
         <row>
          <entry>Parâmetro</entry>
          <entry>Propósito</entry>
         </row>
        </thead>
        <tbody>
         <row>
          <entry>
           <literal>notification</literal>
          </entry>
          <entry>
           Nome da função de retorno de chamada definida pelo usuário a ser chamada sempre que um fluxo ativar uma notificação.
           Suportada apenas para empacotadores de fluxo <link linkend="wrappers.http">http://</link> e
           <link linkend="wrappers.ftp">ftp://</link>.
          </entry>
         </row>
         <row>
          <entry>
           <literal>options</literal>
          </entry>
          <entry>
           Array de opções como em <link linkend="context">opções de contexto e parâmetros</link>.
          </entry>
         </row>
        </tbody>
       </tgroup>
      </table>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1><!-- }}} -->

 <refsect1 role="returnvalues"><!-- {{{ -->
  &reftitle.returnvalues;
  <para>
   &return.success;
  </para>
 </refsect1><!-- }}} -->

 <refsect1 role="errors"><!-- {{{ -->
  &reftitle.errors;
  <simpara>
   Lança um <exceptionname>TypeError</exceptionname> se
   <parameter>context</parameter> não for um fluxo válido ou
   um contexto de fluxo do tipo <type>resource</type>.
  </simpara>
  <simpara>
   Lança um <exceptionname>ValueError</exceptionname> se a
   entrada <literal>options</literal> de <parameter>params</parameter>
   não estiver no formato <literal>$arr['empacotador']['opcao'] = $valor</literal>,
   ou seja, se um de seus elementos não for um array ou tiver uma chave inteira.
  </simpara>
  <simpara>
   Lança um <exceptionname>TypeError</exceptionname> se a
   entrada <literal>options</literal> de <parameter>params</parameter>
   não for um array.
  </simpara>
  <simpara>
   Lança um <exceptionname>TypeError</exceptionname> se a
   entrada <literal>notification</literal> de <parameter>params</parameter>
   não for um retorno de chamada válido.
  </simpara>
 </refsect1><!-- }}} -->

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.5.0</entry>
      <entry>
       Agora lança um <exceptionname>TypeError</exceptionname> se a
       entrada <literal>notification</literal> de <parameter>params</parameter>
       não for um retorno de chamada válido.
      </entry>
     </row>
     <row>
      <entry>8.0.0</entry>
      <entry>
       Agora lança um <exceptionname>TypeError</exceptionname> se
       <parameter>context</parameter> não for um fluxo válido ou um
       <type>resource</type> de contexto de fluxo.
       Anteriormente, um <constant>E_WARNING</constant> era emitido e &false; era retornado.
      </entry>
     </row>
     <row>
      <entry>8.0.0</entry>
      <entry>
       Agora lança um <exceptionname>ValueError</exceptionname> se a
       entrada <literal>options</literal> de <parameter>params</parameter>
       não estiver no formato esperado e um <exceptionname>TypeError</exceptionname>
       se não for um array.
       Anteriormente, um <constant>E_WARNING</constant> era emitido.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="seealso"><!-- {{{ -->
  &reftitle.seealso;
  <simplelist>
   <member><function>stream_notification_callback</function></member>
  </simplelist>
 </refsect1><!-- }}} -->

</refentry>
