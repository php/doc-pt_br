<reference xml:id="enum.streamerrorstore" role="enum" xmlns="http://docbook.org/ns/docbook">
 <title>A enumeração StreamErrorStore</title>
 <titleabbrev>StreamErrorStore</titleabbrev>

 <partintro>
  <section xml:id="enum.streamerrorstore.intro">
   &reftitle.intro;
   <simpara>
    A enumeração <enumname>StreamErrorStore</enumname> especifica quais erros de
    uma operação de fluxo são armazenados para recuperação com
    <function>stream_last_errors</function>. É o valor da
    opção de contexto de fluxo
    <link linkend="context.stream.error-store"><parameter>error_store</parameter></link>.
   </simpara>
  </section>

  <section xml:id="enum.streamerrorstore.synopsis">
   &reftitle.enumsynopsis;

   <enumsynopsis>
    <enumname>StreamErrorStore</enumname>

    <enumitem>
     <enumidentifier>Auto</enumidentifier>
     <enumitemdescription>
      Os erros armazenados dependem do modo de erro.
      Este é o padrão.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>None</enumidentifier>
     <enumitemdescription>
      Nenhum erro é armazenado.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>NonTerminating</enumidentifier>
     <enumitemdescription>
      Apenas os erros não terminais são armazenados.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>Terminating</enumidentifier>
     <enumitemdescription>
      Apenas os erros terminais são armazenados.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>All</enumidentifier>
     <enumitemdescription>
      Todos os erros são armazenados.
     </enumitemdescription>
    </enumitem>
   </enumsynopsis>
  </section>

  <section role="seealso">
   &reftitle.seealso;
   <simplelist>
    <member><enumname>StreamErrorMode</enumname></member>
    <member><function>stream_last_errors</function></member>
    <member><xref linkend="context.stream"/></member>
    <member><xref linkend="stream.errors"/></member>
   </simplelist>
  </section>
 </partintro>
</reference>
