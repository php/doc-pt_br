<reference xml:id="enum.streamerrormode" role="enum" xmlns="http://docbook.org/ns/docbook">
 <title>A enumeração StreamErrorMode</title>
 <titleabbrev>StreamErrorMode</titleabbrev>

 <partintro>
  <section xml:id="enum.streamerrormode.intro">
   &reftitle.intro;
   <simpara>
    A enumeração <enumname>StreamErrorMode</enumname> especifica como os erros de
    uma operação de fluxo são reportados. É o valor da
    opção de contexto de fluxo
    <link linkend="context.stream.error-mode"><parameter>error_mode</parameter></link>.
   </simpara>
  </section>

  <section xml:id="enum.streamerrormode.synopsis">
   &reftitle.enumsynopsis;

   <enumsynopsis>
    <enumname>StreamErrorMode</enumname>

    <enumitem>
     <enumidentifier>Error</enumidentifier>
     <enumitemdescription>
      Os erros são reportados como diagnósticos, como <constant>E_WARNING</constant>.
      Este é o padrão.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>Exception</enumidentifier>
     <enumitemdescription>
      Uma <exceptionname>StreamException</exceptionname> é lançada para
      erros terminais.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>Silent</enumidentifier>
     <enumitemdescription>
      Os erros não são reportados.
     </enumitemdescription>
    </enumitem>
   </enumsynopsis>
  </section>

  <section role="seealso">
   &reftitle.seealso;
   <simplelist>
    <member><enumname>StreamErrorStore</enumname></member>
    <member><xref linkend="context.stream"/></member>
    <member><xref linkend="stream.errors"/></member>
   </simplelist>
  </section>
 </partintro>
</reference>
