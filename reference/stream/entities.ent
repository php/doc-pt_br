<entities xmlns       = "http://docbook.org/ns/docbook"
          xmlns:xlink = "http://www.w3.org/1999/xlink"
          translate   = "yes">

<entity name="ext.stream.context-error-handling">
 <simpara>
  Um <type>resource</type> de contexto criado com
  <function>stream_context_create</function>, ou &null;.
  Suas <link linkend="context.stream">opções de tratamento de erros</link>
  determinam como os erros de stream desta chamada são reportados.
 </simpara>
</entity>

</entities>
