<reference xml:id="class.yaf-response-abstract" role="class" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xi="http://www.w3.org/2001/XInclude">

 <title>A classe Yaf_Response_Abstract</title>
 <titleabbrev>Yaf_Response_Abstract</titleabbrev>

 <partintro>

<!-- {{{ Yaf_Response_Abstract intro -->
  <section xml:id="yaf-response-abstract.intro">
   &reftitle.intro;
   <simpara>
    <classname>Yaf_Response_Abstract</classname> é a classe base do
    objeto de resposta, que carrega os cabeçalhos e os blocos de conteúdo a
    serem enviados ao cliente. Ele é instanciado por
    <classname>Yaf_Dispatcher</classname>; use
    <methodname>Yaf_Dispatcher::getResponse</methodname> para acessá-lo,
    tipicamente dentro de controladores, ações ou plugins.
   </simpara>
   <simpara>
    As subclasses concretas são <classname>Yaf_Response_Http</classname>
    (usada em SAPIs web, que realmente envia cabeçalhos HTTP) e
    <classname>Yaf_Response_Cli</classname> (usada na linha de comando).
   </simpara>
  </section>
<!-- }}} -->

  <section xml:id="yaf-response-abstract.synopsis">
   &reftitle.classsynopsis;

<!-- {{{ Synopsis -->
   <classsynopsis>
    <ooclass><classname>Yaf_Response_Abstract</classname></ooclass>

<!-- {{{ Class synopsis -->
    <classsynopsisinfo>
     <ooclass>
      <classname>Yaf_Response_Abstract</classname>
     </ooclass>
    </classsynopsisinfo>
<!-- }}} -->
    <classsynopsisinfo role="comment">&Constants;</classsynopsisinfo>
    <fieldsynopsis>
     <modifier>const</modifier>
     <type>string</type>
     <varname>Yaf_Response_Abstract::DEFAULT_BODY</varname>
     <initializer>"content"</initializer>
    </fieldsynopsis>

    <classsynopsisinfo role="comment">&Properties;</classsynopsisinfo>
    <fieldsynopsis>
     <modifier>protected</modifier>
     <varname linkend="yaf-response-abstract.props.header">_header</varname>
    </fieldsynopsis>
    <fieldsynopsis>
     <modifier>protected</modifier>
     <varname linkend="yaf-response-abstract.props.body">_body</varname>
    </fieldsynopsis>
    <fieldsynopsis>
     <modifier>protected</modifier>
     <varname linkend="yaf-response-abstract.props.sendheader">_sendheader</varname>
    </fieldsynopsis>


    <classsynopsisinfo role="comment">&Methods;</classsynopsisinfo>
    <xi:include xpointer="xmlns(db=http://docbook.org/ns/docbook) xpointer(id('class.yaf-response-abstract')/db:refentry/db:refsect1[@role='description']/descendant::db:constructorsynopsis[not(@role='procedural')])" />
    <xi:include xpointer="xmlns(db=http://docbook.org/ns/docbook) xpointer(id('class.yaf-response-abstract')/db:refentry/db:refsect1[@role='description']/descendant::db:methodsynopsis[not(@role='procedural')])" />
   </classsynopsis>
<!-- }}} -->

  </section>


<!-- {{{ Yaf_Response_Abstract properties -->
  <section xml:id="yaf-response-abstract.props">
   &reftitle.properties;
   <variablelist>
    <varlistentry xml:id="yaf-response-abstract.props.header">
     <term><varname>_header</varname></term>
     <listitem>
      <simpara>
       Os cabeçalhos HTTP definidos até agora, como um array de pares
       nome/valor. Tem sentido apenas para
       <classname>Yaf_Response_Http</classname>.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-response-abstract.props.body">
     <term><varname>_body</varname></term>
     <listitem>
      <simpara>
       Os blocos de conteúdo, indexados pela chave de conteúdo (por padrão
       <literal>content</literal>, ou seja,
       <literal>Yaf_Response_Abstract::DEFAULT_BODY</literal>).
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-response-abstract.props.sendheader">
     <term><varname>_sendheader</varname></term>
     <listitem>
      <simpara>
       Se os cabeçalhos devem ser enviados junto com o conteúdo. Em
       <classname>Yaf_Response_Http</classname> também rastreia se os
       cabeçalhos já foram enviados.
      </simpara>
     </listitem>
    </varlistentry>
   </variablelist>
  </section>
<!-- }}} -->


 </partintro>

 &reference.yaf.entities.yaf-response-abstract;

</reference>

