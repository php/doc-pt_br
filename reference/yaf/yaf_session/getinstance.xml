<refentry xml:id="yaf-session.getinstance" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
<refname>Yaf_Session::getInstance</refname>
<refpurpose>Obtém o singleton da sessão</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <modifier>static</modifier> <type>Yaf_Session</type><methodname>Yaf_Session::getInstance</methodname>
   <void />
  </methodsynopsis>
  <simpara>Retorna a instância singleton de <classname>Yaf_Session</classname>, criando-a se necessário. A sessão é iniciada automaticamente no primeiro acesso.</simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
<simpara>A instância singleton de <classname>Yaf_Session</classname>, ou &null; se a sessão não puder ser iniciada.</simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>Exemplo de <methodname>Yaf_Session::getInstance</methodname></title>
   <programlisting role="php">
<![CDATA[
<?php
$session = Yaf_Session::getInstance();
$session->start();
$session->set("user_id", 42);

// ... posteriormente, em outro lugar da aplicação
$same = Yaf_Session::getInstance();

var_dump($same === $session);
var_dump($same->get("user_id"));
?>
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
bool(true)
int(42)
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Yaf_Session::start</methodname></member>
   <member><methodname>Yaf_Session::get</methodname></member>
   <member><methodname>Yaf_Session::set</methodname></member>
  </simplelist>
 </refsect1>
</refentry>

