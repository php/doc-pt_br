<refentry xml:id="yaf-session.construct" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
<refname>Yaf_Session::__construct</refname>
<refpurpose>Construtor de Yaf_Session</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <constructorsynopsis>
   <modifier>private</modifier><methodname>Yaf_Session::__construct</methodname>
   <void />
  </constructorsynopsis>
  <simpara>O construtor é privado: <classname>Yaf_Session</classname> implementa o padrão singleton e não pode ser instanciado diretamente. Use <methodname>Yaf_Session::getInstance</methodname> para obter a instância da sessão.</simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
<simpara>Nenhum valor é retornado.</simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>Exemplo de <methodname>Yaf_Session::__construct</methodname></title>
   <programlisting role="php">
<![CDATA[
<?php
// O construtor é privado, portanto Yaf_Session não pode ser
// instanciada com "new". Acesse-a por meio do singleton:
$session = Yaf_Session::getInstance();
$session->start();

$session->set("user_id", 42);
echo $session->get("user_id");
?>
]]>
   </programlisting>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Yaf_Session::getInstance</methodname></member>
   <member><methodname>Yaf_Session::start</methodname></member>
  </simplelist>
 </refsect1>
</refentry>

