<refentry xml:id="yaf-dispatcher.disableview" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Yaf_Dispatcher::disableView</refname>
  <refpurpose>Desativa a renderização de visualização</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type class="union"><type>Yaf_Dispatcher</type><type>null</type></type><methodname>Yaf_Dispatcher::disableView</methodname>
   <void />
  </methodsynopsis>
  <simpara>
   Desativa a renderização de visualizações. Normalmente é usado para ações que
   geram sua própria saída, como ações que retornam dados JSON.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Retorna o próprio objeto <classname>Yaf_Dispatcher</classname> em caso de
   sucesso, ou &null; se a aplicação não estiver inicializada.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>Exemplo de <methodname>Yaf_Dispatcher::disableView</methodname></title>
   <programlisting role="php">
<![CDATA[
<?php
$app = new Yaf_Application(dirname(__FILE__) . "/conf/application.ini");

// Desativa globalmente a renderização; espera-se que cada ação produza
// sua própria saída (por exemplo, um serviço de API JSON).
Yaf_Dispatcher::getInstance()->disableView();

$app->run();
?>
]]>
   </programlisting>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><methodname>Yaf_Dispatcher::enableView</methodname></member>
    <member><methodname>Yaf_Dispatcher::autoRender</methodname></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>

