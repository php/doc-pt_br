<refentry xml:id="yaf-controller-abstract.getviewpath" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Yaf_Controller_Abstract::getViewpath</refname>
  <refpurpose>Obtém o caminho de visualização</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type class="union"><type>string</type><type>null</type></type><methodname>Yaf_Controller_Abstract::getViewpath</methodname>
   <void />
  </methodsynopsis>
  <simpara>
   Retorna o diretório de modelos usado pelo mecanismo de visualização associado a este controlador.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   O diretório de modelos de visualização como uma &string;.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>Exemplo de <methodname>Yaf_Controller_Abstract::getViewpath</methodname></title>
   <programlisting role="php">
<![CDATA[
<?php
class ProductController extends Yaf_Controller_Abstract
{
    public function indexAction() {
        // o diretório de modelos usado pelo mecanismo de visualização,
        // e.g. "/var/www/html/application/views"
        var_dump($this->getViewpath());
    }
}
?>
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
string(31) "/var/www/html/application/views"
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><methodname>Yaf_Controller_Abstract::setViewpath</methodname></member>
    <member><methodname>Yaf_Controller_Abstract::initView</methodname></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>

