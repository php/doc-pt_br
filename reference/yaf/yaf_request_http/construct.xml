 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>Exemplo de <methodname>Yaf_Request_Http::__construct</methodname></title>
   <programlisting role="php">
<![CDATA[
<?php
/**
 * Constrói uma requisição HTTP explicitamente com um URI e um URI base.
 *
 * Se o URI da requisição for omitido, ele será obtido das habituais
 * variáveis de $_SERVER ($_SERVER["PATH_INFO"], $_SERVER["REQUEST_URI"], ...).
 */
$request = new Yaf_Request_Http("/product/detail/id/10", "/product");

var_dump($request->getMethod());
var_dump($request->getRequestUri());
var_dump($request->getBaseUri());
?>
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
string(3) "GET"
string(21) "/product/detail/id/10"
string(8) "/product"
]]>
   </screen>
  </example>
