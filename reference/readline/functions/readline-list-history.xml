<refentry xmlns="http://docbook.org/ns/docbook" xml:id="function.readline-list-history">
 <refnamediv>
  <refname>readline_list_history</refname>
  <refpurpose>Lista o histórico</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>array</type><methodname>readline_list_history</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Obtém o histório completo da linha de comando.
  </simpara>
  <simpara>
   Esta função só está disponível se a biblioteca readline usada na compilação
   do PHP fornecer listagem do histórico. Este é sempre o caso com GNU Readline
   e no Windows.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Retorna um array do histórico completo da linha de comando. Os elementos são
   indexados por inteiros iniciando de zero.
  </simpara>
 </refsect1>

</refentry>
