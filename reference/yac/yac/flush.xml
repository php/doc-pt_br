<refentry xml:id="yac.flush" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Yac::flush</refname>
  <refpurpose>Descarrega o cache</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type>bool</type><methodname>Yac::flush</methodname>
   <void />
  </methodsynopsis>
  <simpara>
    Remove todos os valores em cache. Como o cache é compartilhado por
    todos os processos da mesma máquina, isto o esvazia globalmente; o
    prefixo de chave fornecido a <methodname>Yac::__construct</methodname>
    não limita o que será removido.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Retorna &true;.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>Exemplo de <methodname>Yac::flush</methodname></title>
   <programlisting role="php">
<![CDATA[
<?php
$yac = new Yac();
$yac->set("foo", "bar");

$other = new Yac("app2_");
$other->set("baz", "qux");

// flush esvazia o cache inteiro: entradas de todas as instâncias,
// independentemente do prefixo usado ao armazená-las
$yac->flush();

var_dump($yac->get("foo"));   // bool(false)
var_dump($other->get("baz")); // bool(false)
?>
]]>
   </programlisting>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
