<reference xml:id="class.gmp" role="class" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xi="http://www.w3.org/2001/XInclude">

 <title>A classe GMP</title>
 <titleabbrev>GMP</titleabbrev>

 <partintro>
  <section xml:id="gmp.intro">
   &reftitle.intro;
   <para>
    Representa um número GMP. Este objeto suporta sobrecarga dos operadores
    <link linkend="language.operators.arithmetic">aritméticos</link>,
    <link linkend="language.operators.bitwise">binários</link> e
    <link linkend="language.operators.comparison">comparativos</link>.
   </para>
   <note>
    <para>
     Nenhuma interface orientada a objeto é provida para manipular objetos
     <classname>GMP</classname>. Para isto, favor usar a
     <link linkend="book.gmp">API GMP procedural</link>.
    </para>
   </note>
  </section>

  <section xml:id="gmp.synopsis">
   &reftitle.classsynopsis;

   <classsynopsis class="class">
    <ooclass>
     <modifier>final</modifier>
     <classname>GMP</classname>
    </ooclass>

    <classsynopsisinfo role="comment">&Methods;</classsynopsisinfo>
    <xi:include xpointer="xmlns(db=http://docbook.org/ns/docbook) xpointer(id('class.gmp')/db:refentry/db:refsect1[@role='description']/descendant::db:constructorsynopsis[@role='GMP'])"/>
    <xi:include xpointer="xmlns(db=http://docbook.org/ns/docbook) xpointer(id('class.gmp')/db:refentry/db:refsect1[@role='description']/descendant::db:methodsynopsis[@role='GMP'])"/>
   </classsynopsis>
  </section>

  <section role="changelog">
   &reftitle.changelog;
   <informaltable>
    <tgroup cols="2">
     <thead>
      <row>
       <entry>&Version;</entry>
       <entry>&Description;</entry>
      </row>
     </thead>
     <tbody>
      <row>
       <entry>8.4.0</entry>
       <entry>
        <classname>GMP</classname> agora é marcada como <modifier>final</modifier>.
       </entry>
      </row>
      <row>
       <entry>8.4.0</entry>
       <entry>
        Um objeto <classname>GMP</classname> agora pode ser convertido para
        <type>bool</type>; um objeto representando <literal>0</literal> é convertido
        para &false;, e qualquer outro valor para &true;. Anteriormente, a conversão para
        <type>bool</type> emitia um <constant>E_RECOVERABLE_ERROR</constant>.
       </entry>
      </row>
     </tbody>
    </tgroup>
   </informaltable>
  </section>
 </partintro>

 &reference.gmp.entities.gmp;

</reference>
