<refentry xml:id="function.gzinflate" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>gzinflate</refname>
  <refpurpose>Descomprime uma string comprimida</refpurpose>
 </refnamediv>
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type class="union"><type>string</type><type>false</type></type><methodname>gzinflate</methodname>
   <methodparam><type>string</type><parameter>data</parameter></methodparam>
   <methodparam choice="opt"><type>int</type><parameter>max_length</parameter><initializer>0</initializer></methodparam>
  </methodsynopsis>
  <para>
   Esta função descomprime uma string comprimida.
  </para>
 </refsect1>
 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>data</parameter></term>
     <listitem>
      <para>
       Os dados comprimidos por <function>gzdeflate</function>.
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>max_length</parameter></term>
     <listitem>
      <para>
       O comprimento máximo dos dados decodificados.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Os dados não comprimidos originais ou &false; em caso de erro.
  </para>
 </refsect1>
 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Lança um <exceptionname>ValueError</exceptionname> se <parameter>max_length</parameter>
   for negativo. Se <parameter>data</parameter> não for um dado comprimido válido, ou se os
   dados não comprimidos forem muito grandes para <parameter>max_length</parameter> quando não for
   <literal>0</literal>, um <constant>E_WARNING</constant> é gerado e &false; é retornado.
  </simpara>
 </refsect1>
 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.0.0</entry>
      <entry>
       Agora lança um <exceptionname>ValueError</exceptionname> se <parameter>max_length</parameter>
       for negativo. Anteriormente, um <constant>E_WARNING</constant> era gerado
       e &false; era retornado.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>
 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>Exemplo de <function>gzinflate</function></title>
    <programlisting role="php">
<![CDATA[
<?php
$compressed   = gzdeflate('Me comprima', 9);
$uncompressed = gzinflate($compressed);
echo $uncompressed;
?>
]]>
    </programlisting>
   </example>
  </para>
 </refsect1>
 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>gzdeflate</function></member>
    <member><function>gzcompress</function></member>
    <member><function>gzuncompress</function></member>
    <member><function>gzencode</function></member>
   </simplelist>
  </para>
 </refsect1>
</refentry>
