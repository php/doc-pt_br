<refentry xml:id="solrquery.gethighlightquery" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>SolrQuery::getHighlightQuery</refname>
  <refpurpose>Retorna a consulta de destaque</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type class="union"><type>string</type><type>null</type></type><methodname>SolrQuery::getHighlightQuery</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Retorna a consulta de destaque definida anteriormente no parâmetro
   <literal>hl.q</literal>. Este parâmetro permite destacar termos
   ou campos diferentes dos usados para
   recuperar documentos. Consulte a seção <link xlink:href="https://solr.apache.org/guide/solr/latest/query-guide/highlighting.html">Destaques</link>
   para mais detalhes.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Retorna uma string contendo a consulta de destaque do <classname>SolrQuery</classname> atual, ou &null; se a consulta
   de destaque não estiver definida.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>SolrQuery::setHighlightQuery</methodname></member>
   <member><methodname>SolrQuery::getHighlightFields</methodname></member>
   <member><methodname>SolrQuery::setHighlightFields</methodname></member>
  </simplelist>
 </refsect1>
</refentry>
