<!-- EN-Revision: 6a1e42bcba9133ba0579636a85c77753092e1d8d Maintainer: leonardolara Status: ready -->
<!--

Entities for the categorized extension list.

-->

<entities xmlns       = "http://docbook.org/ns/docbook"
          translate   = "yes">

<entity name="extcat.alphabetical"><title>Ordem alfabética</title></entity>

<entity name="extcat.intro">
 <title>Categorização/Lista das Extensões</title>
 <simpara>
   Este apêndice categoriza mais de 150 extensões documentadas no
   Manual do PHP por vários critérios.
 </simpara>
</entity>

<entity name="extcat.membership"><title>Classificadas por Pertencimento</title></entity>

<entity name="extcat.membership.bundled">
 <title>Extensões Agregadas</title>
 <simpara>Estas extensões são incluídas no PHP.</simpara>
</entity>

<entity name="extcat.membership.core">
 <title>Extensões de Núcleo</title>
 <simpara>
  Estas não são extensões reais. Elas fazem parte do núcleo do PHP
  e não podem ser excluídas de um binário do PHP com opções de compilação.
 </simpara>
</entity>

<entity name="extcat.membership.external">
 <title>Extensões Externas</title>
 <simpara>
  Estas extensões são agregadas ao PHP, mas para compilá-las,
  bibliotecas externas serão necessárias.
 </simpara>
</entity>

<entity name="extcat.membership.pecl">
 <title>Extensões PECL</title>
 <simpara>
  Estas extensões estão disponíveis em &link.pecl;. Elas podem
  requerer bibliotecas externas. Mais extensões PECL existem, mas
  ainda não estão documentadas no manual do PHP.
 </simpara>
</entity>

<entity name="extcat.state">
 <title>Estado</title>
 <simpara>
  Esta seção lista extensões não destinadas ao uso em produção —
  elas são ou muito "antigas" (descontinuadas) ou "novas" (experimentais).
 </simpara>
</entity>

<entity name="extcat.state.deprecated">
 <title>Extensões Descontinuadas</title>
 <simpara>
  Estas extensões foram descontinuadas, geralmente em favor de
  outras extensões.
 </simpara>
</entity>

<entity name="extcat.state.experimental">
 <title>Extensões Experimentais</title>
 <simpara>
  O comportamento destas extensões — incluindo os nomes de suas
  funções e qualquer outra coisa documentada sobre estas extensões —
  pode mudar sem aviso prévio em uma futura versão do PHP. Use estas
  extensões por sua própria conta e risco.
 </simpara>
</entity>

</entities>
